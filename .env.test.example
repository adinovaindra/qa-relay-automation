
# Explicit opt-in for QA automation
QA_AUTOMATION_ENABLED=1

# Absolute path to the local Relay application repository
RELAY_APP_DIR=REPLACE_WITH_ABSOLUTE_PATH_TO_RELAY_APP

# Dedicated QA database only
DATABASE_URL="postgresql://relay_test_user:REPLACE_WITH_TEST_ROLE_PASSWORD@127.0.0.1:5432/relay_qa_automation?schema=public"

# Test-only secret; never reuse a production secret
JWT_SECRET=REPLACE_WITH_A_RANDOM_TEST_ONLY_SECRET_AT_LEAST_32_CHARACTERS
